# --- Obligatorias ---
# Base de datos (Postgres). En el VPS: localhost y el puerto mapeado del contenedor.
DATABASE_URL="postgresql://tienda_user:CAMBIAR@localhost:5450/tienda_db?schema=public"
# URL pública del sitio (la usan los enlaces de los mails y NextAuth)
NEXTAUTH_URL="https://tienda.tudominio.com"
# Secreto de sesiones: generalo con `openssl rand -base64 32`
AUTH_SECRET=""

# --- Imágenes y videos (Cloudflare R2): se pueden cargar desde el panel (Configuración → Imágenes) o acá ---
# Sin estas 5 variables las imágenes se guardan en disco (sirve para desarrollo, no para producción).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Dominio público del bucket (R2 → Settings → Public access / dominio propio), sin barra final
R2_PUBLIC_URL="https://cdn.tudominio.com"

# --- Opcional ---
# Inicio de sesión con Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Todo lo demás (mail, IA, pagos, Telegram, WhatsApp, moneda, etc.) se configura desde el panel
# de administración (Configuración), no con variables de entorno.
